{
    "id" : "net.sapples.LiveCaptions",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "livecaptions",
    "finish-args" : [
        "--share=ipc",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--socket=fallback-x11"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/onnxruntime/include",
        "/onnxruntime/lib/cmake",
        "/onnxruntime/lib/pkgconfig",
        "/lib/libaprilasr.so*",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "onnxruntime",
            "buildsystem" : "simple",
            "sources" : [
                {
                    "type" : "archive",
                    "only-arches" : ["x86_64"],
                    "url" : "https://github.com/microsoft/onnxruntime/releases/download/v1.30.0/onnxruntime-linux-x64-1.30.0.tgz",
                    "sha256" : "a5ed5a3cac51fbb2e90da632ae43d19212faaa20e76484e62bcb7c23ddb3b3fd"
                },
                {
                    "type" : "archive",
                    "only-arches" : ["aarch64"],
                    "url" : "https://github.com/microsoft/onnxruntime/releases/download/v1.30.0/onnxruntime-linux-aarch64-1.30.0.tgz",
                    "sha256" : "e16a27a8ed330bbc698df7330b0cf56e722f354e3bcc92118682c74ef3c3e3da"
                }
            ],
            "build-commands" : [
                "mkdir -p ${FLATPAK_DEST}/onnxruntime",
                "cp -a include lib LICENSE ThirdPartyNotices.txt ${FLATPAK_DEST}/onnxruntime/"
            ]
        },
        {
            "name" : "aprilmodel",
            "buildsystem" : "simple",
            "sources" : [
                {
                    "type" : "file",
                    "dest-filename" : "aprilv0_en-us.april",
                    "url" : "https://april.sapples.net/april-english-dev-01110_en.april",
                    "sha256" : "77eb95d0fa4f7708a37e868c2265301ee6c42dcb25e63ca63eea3d9cbadbc1f3"
                }
            ],
            "build-commands" : [
                "install -Dm644 aprilv0_en-us.april -t ${FLATPAK_DEST}/LiveCaptions/models"
            ]
        },
        {
            "name" : "livecaptions",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : ["--buildtype=release"],
            "build-options" : {
                "env" : {
                    "ONNX_ROOT" : "/app/onnxruntime"
                }
            },
            "sources" : [
                {
                    "type" : "dir",
                    "path" : "../..",
                    "skip" : [
                        "builddir",
                        "_build",
                        "result",
                        ".flatpak-builder",
                        "subprojects/april-asr/lib",
                        "april-english-dev-01110_en.april"
                    ]
                }
            ]
        }
    ]
}
